# Enforce UTF-8 line endings for all text files
* text=auto eol=lf

# Explicitly mark web source files as UTF-8
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.env  text eol=lf

# Binary files — never mangle
*.png  binary
*.jpg  binary
*.webp binary
*.ico  binary
*.zip  binary
