{
  "name": "test12",
  "version": "1.0.0",
  "description": "WebMCP-compliant audio-only web browser powered by xAI Grok STT & TTS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "web": "node web.js",
    "dev": "node web.js",
    "dev:ui": "node dev.js",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/dist/tailwind.css --watch",
    "monitor:ralph": "node scripts/ralph-usage-monitor.mjs",
    "monitor:ralph:once": "node scripts/ralph-usage-monitor.mjs --once",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:a11y": "playwright test a11y-audit",
    "test:vmode": "playwright test vmode-config"
  },
  "bin": {
    "test12": "./server.js"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1045.0",
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/client-secrets-manager": "^3.1041.0",
    "@aws-sdk/client-ses": "^3.1048.0",
    "@aws-sdk/client-sns": "^3.1048.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.5.0",
    "@vendia/serverless-express": "^4.12.6",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.6.2",
    "jsdom": "^25.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "node-fetch": "^2.7.0",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
