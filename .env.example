# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── xAI (STT / TTS / Realtime) ────────────────────────────────────────────────
XAI_API_KEY=xai-YOUR_KEY_HERE

# ── Anthropic Claude (Standard plan Haiku + Deluxe Claude Sonnet) ──────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── OpenAI (Deluxe OpenAI realtime) ───────────────────────────────────────────
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# ── DynamoDB ───────────────────────────────────────────────────────────────────
DDB_DATA_TABLE=test12-data
# DB_SECRET_ARN only needed if using RDS (not required for DynamoDB-only setup)
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:NAME

# ── Stripe Billing ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
STRIPE_DELUXE_XAI_PRICE_ID=price_YOUR_PRICE_ID
STRIPE_DELUXE_CLAUDE_PRICE_ID=price_YOUR_PRICE_ID
STRIPE_DELUXE_OPENAI_PRICE_ID=price_YOUR_PRICE_ID
STRIPE_MONTHLY_SUBSCRIPTION_PRICE_ID=price_YOUR_PRICE_ID

# ── Admin API ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SECRET_KEY=GENERATE_A_RANDOM_KEY_HERE

# ── App ────────────────────────────────────────────────────────────────────────
# Set to your production URL; controls CORS and invite links.
# Leave unset for local dev (allows all origins).
BASE_URL=https://test12.net
# PORT=3000

# ── OAuth (Social Login) ───────────────────────────────────────────────────────
# Google: https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_SECRET_HERE

# Apple: https://developer.apple.com → Certificates → Services IDs → Sign in with Apple
APPLE_SERVICE_ID=

# ── AWS (set in shell, not here — dotenv runs too late for AWS SDK) ────────────
# Run: $env:AWS_PROFILE='sdegrandpre'; npm run dev
# Or use dev.local.ps1 (git-ignored launch script)
